/openclaw-weixin/
accounts.json
*.sync.json
*.context-tokens.json
*.session-pause.json
ref-messages.sqlite
ref-messages.sqlite-*
debug-mode.json
/media/
.idea/
.vscode/
.DS_Store

# Language binding build artifacts
bindings/python/**/__pycache__/
bindings/python/*.egg-info/
bindings/python/build/
bindings/python/dist/
bindings/go/**/*.exe
bindings/cpp/*.exe
bindings/cpp/build/
bindings/java/out/
bindings/java/target/
bindings/kotlin/build/
bindings/kotlin/kbuild/
bindings/kotlin/.gradle/
# Native libraries staged into the bindings for packaging (see
# bindings/scripts/stage_native.py). They are build artifacts, regenerated per
# platform by CI, so they are not committed.
bindings/java/src/main/resources/io/ilink/sdk/native/*/
bindings/kotlin/src/main/resources/io/ilink/sdk/native/*/
bindings/go/ilink/native/*/
# Stray Kotlin/JVM output from manual compiles
/io/
/build/
/META-INF/
